#!name=AdBlock-Script (Surge)
#!desc=Quantumult X rules converted for Surge; enable Rewrite and configure MITM certificate.
# Source: quantumultx/rewrite/AdBlock-Script.conf
# Rules: 35
# Requires Surge iOS 5.9.1+ / Mac 5.5.1+.

[URL Rewrite]
^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/other_modul _ reject
^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/user_related_modul _ reject
^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/wiki_related_modul _ reject

[Script]
AdBlock-Script-004 = type=http-request, pattern=^https?:\/\/api\.zhihu\.com\/feed-root\/block, requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-005 = type=http-response, pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/list, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/startup/startup.js
AdBlock-Script-006 = type=http-response, pattern=^https?:\/\/fmapp\.chinafamilymart\.com\.cn\/api\/app\/market\/start\/ad, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/startup/startup.js
AdBlock-Script-007 = type=http-response, pattern=^https?:\/\/hd\.mina\.mi\.com\/splashscreen\/alert, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/startup/startup.js
AdBlock-Script-008 = type=http-response, pattern=^https?:\/\/zhiyou\.m\.smzdm\.com\/user\/vip\/ajax_get_banner, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/smzdm/smzdm_remove_ads.js
AdBlock-Script-009 = type=http-response, pattern=^https?:\/\/haojia-api\.smzdm\.com\/home\/list\?, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/smzdm/smzdm_remove_ads.js
AdBlock-Script-010 = type=http-response, pattern=^https?:\/\/haojia\.m\.smzdm\.com\/detail_modul\/article_releated_modul, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/smzdm/smzdm_remove_ads.js
AdBlock-Script-011 = type=http-response, pattern=^https?:\/\/app-api\.smzdm\.com\/util\/loading, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/smzdm/smzdm_remove_ads.js
AdBlock-Script-012 = type=http-response, pattern=^https?:\/\/s-api\.smzdm\.com\/sou\/filter\/tags\/hot_tags, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/smzdm/smzdm_remove_ads.js
AdBlock-Script-013 = type=http-response, pattern=^https?:\/\/s-api\.smzdm\.com\/sou\/list_v10, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/smzdm/smzdm_remove_ads.js
AdBlock-Script-014 = type=http-response, pattern=^https?:\/\/baike-api\.smzdm\.com\/home_v3\/list, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/smzdm/smzdm_remove_ads.js
AdBlock-Script-015 = type=http-response, pattern=^https?:\/\/homepage-api\.smzdm\.com\/v3\/home, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/smzdm/smzdm_remove_ads.js
AdBlock-Script-016 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/root\/tab\/v2, requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
