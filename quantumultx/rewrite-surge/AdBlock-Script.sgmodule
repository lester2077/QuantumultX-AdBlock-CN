AdBlock-Script-018 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/settings\/blocked_users, requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-019 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/next-render, requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-020 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/(v4\/)?questions\/\d+, requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-021 = type=http-response, pattern=^https:\/\/(page-info|api)\.zhihu\.com\/answers\/v2\/\d+, requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-022 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/people, requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-023 = type=http-response, pattern=^https:\/\/(api|web-render)\.zhihu\.com\/topstory\/recommend, requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-024 = type=http-response, pattern=^https:\/\/api\.zhihu\.com\/articles\/v\d\/\d+, requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-025 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/notifications\/v3\/(message\?|timeline\/entry\/system_message), requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-026 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/topstory\/hot-lists?(\?|\/), requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-027 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/search\/recommend_query, requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-028 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/(comment_v5\/)?(answers|comments?|articles|pins)\/\d+\/(root_|child_)?comments?, requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-029 = type=http-response, pattern=^https?:\/\/www\.zhihu\.com\/api\/v4\/comment_v5\/answers\/\d+\/abstract_comment\?, requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-030 = type=http-response, pattern=^https?:\/\/api\.zhihu\.com\/search\/preset_words\?, requires-body=true, script-path=https://gist.githubusercontent.com/blackmatrix7/f5f780d0f56b319b6ad9848fd080bb18/raw/zheye.min.js
AdBlock-Script-031 = type=http-response, pattern=^https?:\/\/capis(-?\w*)?\.didapinche\.com\/ad\/cx\/startup\?, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/startup/startup.js
AdBlock-Script-032 = type=http-response, pattern=^https?:\/\/cmsapi\.dmall\.com\/app\/home\/homepageStartUpPic, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/startup/startup.js
AdBlock-Script-033 = type=http-response, pattern=^https?:\/\/(t7z|kjp)\.cupid\.iqiyi\.com\/mixer\?, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/startup/startup.js
AdBlock-Script-034 = type=http-response, pattern=^https?:\/\/wmapi\.meituan\.com\/api\/v\d+\/loadInfo?, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/startup/startup.js
AdBlock-Script-035 = type=http-response, pattern=^https?:\/\/mi\.gdt\.qq\.com\/gdt_mview\.fcg, requires-body=true, script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/startup/startup.js

